<?xml version="1.0"?>
<!-- Compatibility description: the stock Waffle URDF supplies all TF frames.
     Gazebo is spawned separately from models/turtlebot3_waffle/model.sdf. -->
<robot name="turtlebot3_waffle" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find rc_navigation)/urdf/turtlebot3_waffle.urdf"/>
</robot>
